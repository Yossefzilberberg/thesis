# Anthropic API key — required for the AI research assistant.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the research assistant. Defaults to Claude Opus 4.6.
ANTHROPIC_MODEL=claude-opus-4-6

# Optional: model for fast, lower-cost passes (outline drafting, citation formatting).
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001
